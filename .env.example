# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# service
ENVIRONMENT=local
LOG_LEVEL=INFO
API_KEY=dev-key-change-me

# ---------------------------------------------------------------------------
# LLM provider: azure | azure_foundry | anthropic | ollama
# ---------------------------------------------------------------------------
LLM_PROVIDER=azure
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Azure OpenAI Service — ONE resource, ONE endpoint, ONE key.
# The two deployments (chat + embeddings) live on this same resource and are
# addressed by NAME; they do not have their own keys. Portal path:
# resource -> Keys and Endpoint. API version: copy from the code sample on
# either deployment's page in Azure AI Foundry.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Foundry (serverless MaaS — Grok/Mistral/etc.; separate resource,
# so this one DOES have its own endpoint + key)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=

# Anthropic (config-switchable secondary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Ollama (local/offline fallback)
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# database
# inside docker-compose the host is `db`; locally it is `localhost`
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/jira_copilot
