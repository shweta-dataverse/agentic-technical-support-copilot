# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# service
ENVIRONMENT=local
LOG_LEVEL=INFO
API_KEY=dev-key-change-me

# ---------------------------------------------------------------------------
# LLM provider: azure | azure_foundry | anthropic | ollama
# ---------------------------------------------------------------------------
LLM_PROVIDER=azure_foundry
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Azure OpenAI Service (gold keyword; needs Standard/Global-Standard quota)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure AI Foundry (serverless MaaS — Grok/Mistral/etc.)
# from the deployment's "Consume/Endpoint" tab: Target URI + Key
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=grok-4-20-reasoning

# Anthropic (config-switchable secondary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Ollama (local/offline fallback)
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# embeddings + database
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# inside docker-compose the host is `db`; locally it is `localhost`
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/jira_copilot
